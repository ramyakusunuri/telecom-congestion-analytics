# Copy this file to ".env" and fill in real values.
# .env is never committed / never hard-coded in source.

# Set to "true" to make the app use PostgreSQL.
# Set to "false" (or leave unset) to use the local CSV/Parquet fallback automatically.
USE_POSTGRES=false

DB_HOST=localhost
DB_PORT=5432
DB_NAME=telecom_congestion
DB_USER=postgres
DB_PASSWORD=changeme
